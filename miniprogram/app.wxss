page {
  background: #f4f6f7;
  color: #1f2a30;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
button,
switch {
  box-sizing: border-box;
}

button::after {
  border: 0;
}
