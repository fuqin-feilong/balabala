.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 40rpx;
  box-sizing: border-box;
  background-color: #f4f6f7;
  background-image:
    radial-gradient(circle at 6% 0%, rgba(95, 143, 132, 0.09), transparent 32%),
    radial-gradient(circle at 94% 8%, rgba(138, 122, 168, 0.07), transparent 30%),
    linear-gradient(180deg, #f4f6f7 0%, #f8fafa 45%, #f1f4f7 100%);
  color: #1f2a30;
}

.hero {
  padding: 22rpx 8rpx 26rpx;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: #7c8f8a;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-title {
  color: #1f2a30;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 10rpx;
  color: #6b7780;
  font-size: 23rpx;
  line-height: 1.5;
}

.card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(31, 45, 55, 0.08);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(31, 45, 55, 0.06);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #5f8f84, #a8c4bb);
}

.card-cost::before {
  background: linear-gradient(90deg, #5f8f84, #a8c4bb);
}

.result-card::before {
  background: linear-gradient(90deg, #6f8faf, #afc3d5);
}

.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  color: #1f2a30;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-sub {
  margin-top: 6rpx;
  color: #6b7780;
  font-size: 22rpx;
  line-height: 1.5;
}

.mini-link {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border: 1rpx solid #d5e3de;
  border-radius: 999rpx;
  background: #eff5f3;
  color: #4f6b64;
  font-size: 21rpx;
  font-weight: 600;
}

.money-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 8rpx 0 14rpx;
  border-bottom: 1rpx solid #e8edef;
}

.money-input-row.small {
  margin-top: 8rpx;
}

.money-symbol {
  color: #5f8f84;
  font-size: 34rpx;
  font-weight: 700;
}

.money-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: #1f2a30;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 78rpx;
}

.money-input-row.small .money-input {
  height: 60rpx;
  font-size: 38rpx;
  line-height: 60rpx;
}

.money-unit {
  color: #8a959d;
  font-size: 22rpx;
}

.divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: #edf1f2;
}

.field-label {
  color: #3f4a50;
  font-size: 24rpx;
  font-weight: 600;
}

.inline-hint {
  color: #8a959d;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: right;
}

.highlight-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  line-height: 1.5;
}

.highlight-teal {
  border: 1rpx solid #d7e6e1;
  background: #f1f7f5;
}

.highlight-amber {
  border: 1rpx solid #ecdfc8;
  background: #faf5ec;
}

.highlight-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4f7c74;
  font-size: 19rpx;
  font-weight: 700;
}

.highlight-amber .highlight-tag {
  color: #8a6a3f;
}

.highlight-text {
  color: #5c686f;
  font-size: 21rpx;
  line-height: 1.55;
}

.field-block {
  margin-top: 22rpx;
}

.text-input {
  height: 82rpx;
  border-bottom: 1rpx solid #e8edef;
  color: #1f2a30;
  font-size: 26rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 62rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dde5e7;
  border-radius: 999rpx;
  background: #f7f9fa;
  color: #5c686f;
  font-size: 23rpx;
  font-weight: 600;
}

.chip.active {
  border-color: #4f7c74;
  background: linear-gradient(135deg, #5f8f84, #4f7c74);
  color: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(79, 124, 116, 0.18);
}

.chip-input-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 130rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border: 1rpx dashed #c9d4d7;
  border-radius: 999rpx;
  background: #ffffff;
}

.chip-input {
  width: 66rpx;
  color: #1f2a30;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

.chip-input-unit {
  color: #8a959d;
  font-size: 21rpx;
}

.segment {
  display: flex;
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f0f3f4;
}

.segment.three .segment-item {
  flex: 1;
}

.segment-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  border-radius: 14rpx;
  color: #6b7780;
  font-size: 22rpx;
  font-weight: 600;
}

.segment-item.active {
  background: #ffffff;
  color: #3f6b62;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 55, 0.08);
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border: 1rpx dashed #c9d4d7;
  border-radius: 16rpx;
  background: #fbfcfc;
}

.custom-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  color: #1f2a30;
  font-size: 23rpx;
}

.custom-unit {
  color: #8a959d;
  font-size: 21rpx;
}

.custom-add {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eff5f3;
  color: #4f6b64;
  font-size: 21rpx;
  font-weight: 700;
}

.two-options {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.option-card {
  flex: 1;
  min-width: 0;
  padding: 18rpx 18rpx;
  border: 1rpx solid #dde5e7;
  border-radius: 18rpx;
  background: #f8fafb;
}

.option-card.active {
  border-color: #4f7c74;
  background: #f0f6f4;
  box-shadow: inset 0 0 0 1rpx rgba(79, 124, 116, 0.2);
}

.option-title {
  color: #3f4a50;
  font-size: 24rpx;
  font-weight: 700;
}

.option-card.active .option-title {
  color: #3f6b62;
}

.option-sub {
  margin-top: 6rpx;
  color: #8a959d;
  font-size: 19rpx;
  line-height: 1.4;
}

.result-head {
  align-items: center;
}

.result-count {
  flex-shrink: 0;
  color: #4f6b64;
  font-size: 22rpx;
  font-weight: 700;
}

.quote-list {
  margin-top: 8rpx;
}

.quote-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.quote-row:last-child {
  border-bottom: 0;
}

.quote-main {
  flex: 1;
  min-width: 0;
}

.quote-label {
  color: #1f2a30;
  font-size: 25rpx;
  font-weight: 700;
}

.quote-meta {
  margin-top: 6rpx;
  color: #7b8794;
  font-size: 20rpx;
  line-height: 1.45;
}

.floor-badge {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #fbf0e6;
  color: #9a6a3f;
  font-size: 18rpx;
  font-weight: 700;
}

.quote-price {
  flex-shrink: 0;
  color: #2f5d55;
  font-size: 32rpx;
  font-weight: 800;
}

.copy-btn {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border: 1rpx solid #d5e3de;
  border-radius: 999rpx;
  background: #eff5f3;
  color: #4f6b64;
  font-size: 20rpx;
  font-weight: 600;
}

.warnings {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #faf5ec;
}

.warning-item {
  color: #8a6a3f;
  font-size: 20rpx;
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.action-btn.secondary {
  border: 1rpx solid #dde5e7;
  background: #f7f9fa;
  color: #5c686f;
}

.action-btn.primary {
  background: linear-gradient(135deg, #5f8f84, #4f7c74);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(79, 124, 116, 0.2);
}

.empty-lines {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f9fa;
  color: #7b8794;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.empty-quote {
  padding: 44rpx 26rpx;
  text-align: center;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #eff5f3;
  color: #4f7c74;
  font-size: 40rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 18rpx;
  color: #1f2a30;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  color: #7b8794;
  font-size: 21rpx;
  line-height: 1.55;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 30rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: #eff5f3;
  color: #4f6b64;
  font-size: 23rpx;
  font-weight: 700;
}

.footnote {
  margin-top: 8rpx;
  color: #8a959d;
  font-size: 20rpx;
  line-height: 1.55;
}

.footnote.center {
  text-align: center;
  padding: 10rpx 20rpx;
}

.page-bottom-space {
  height: 30rpx;
}
