.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

/* ---------- Hero ---------- */
.hero {
  padding: 22rpx 8rpx 26rpx;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: #b08a4a;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-title {
  color: #2f2a22;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: #8d8271;
  font-size: 25rpx;
  line-height: 1.5;
}

/* ---------- Cards ---------- */
.card,
.result-card,
.empty-state {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(116, 91, 47, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(82, 62, 26, 0.05);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-head-main {
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-title {
  color: #2f2a22;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-sub {
  margin-top: 6rpx;
  color: #9a907f;
  font-size: 23rpx;
  line-height: 1.5;
}

.card-summary {
  margin-top: 10rpx;
  color: #8a7b64;
  font-size: 23rpx;
  line-height: 1.5;
}

.chevron {
  color: #b7a98f;
  font-size: 28rpx;
  line-height: 1;
}

.card-body {
  margin-top: 24rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.divider {
  height: 1rpx;
  margin: 26rpx 0;
  background: #f0e9dc;
}

.section-label {
  color: #3b342a;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.4;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.section-note {
  color: #a29683;
  font-size: 22rpx;
}

.inline-hint {
  color: #9a907f;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- Segmented controls ---------- */
.segment {
  display: flex;
  flex-shrink: 0;
  padding: 4rpx;
  border-radius: 16rpx;
  background: #f4eee3;
}

.segment.small .segment-item {
  min-width: 78rpx;
  height: 52rpx;
  padding: 0 14rpx;
  font-size: 23rpx;
}

.segment-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  color: #8c8170;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  transition: all 0.18s ease;
}

.segment-item.active {
  background: #ffffff;
  color: #a56d0b;
  box-shadow: 0 4rpx 12rpx rgba(91, 68, 29, 0.09);
}

/* ---------- Price ---------- */
.price-input-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
  padding: 12rpx 0 8rpx;
  border-bottom: 1rpx solid #f0e9dc;
}

.price-currency {
  color: #c18a2d;
  font-size: 38rpx;
  font-weight: 700;
}

.price-input {
  flex: 1;
  height: 100rpx;
  padding: 0;
  color: #2f2a22;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 100rpx;
}

.price-input::placeholder {
  color: #d9d0c1;
}

.price-unit {
  color: #9a907f;
  font-size: 25rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quick-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f8f3e9;
  color: #7e705b;
  font-size: 23rpx;
  line-height: 1.3;
}

.tax-hint {
  margin-top: 12rpx;
  color: #b08a4a;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- Chips ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  background: #f6f1e7;
  color: #6f6454;
  font-size: 23rpx;
  line-height: 1.3;
  transition: all 0.18s ease;
}

.chip.subtle {
  background: #faf7f0;
  border-color: #eee5d7;
  color: #8a7b64;
}

.chip.active {
  border-color: #e8bf6a;
  background: #fbf0d5;
  color: #9a6200;
  font-weight: 650;
}

.chip-input-wrap {
  display: inline-flex;
  align-items: center;
  min-height: 58rpx;
  padding: 0 16rpx;
  border: 1rpx dashed #d9c9ad;
  border-radius: 999rpx;
  background: #fffdf8;
}

.chip-input {
  width: 66rpx;
  height: 52rpx;
  padding: 0;
  color: #5f5342;
  font-size: 23rpx;
  text-align: center;
}

.chip-input-unit {
  color: #9a907f;
  font-size: 21rpx;
}

/* ---------- Settlement options ---------- */
.two-options {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.option-card {
  flex: 1;
  min-width: 0;
  padding: 18rpx 18rpx 16rpx;
  border: 1rpx solid #f0e8da;
  border-radius: 18rpx;
  background: #faf7f0;
  transition: all 0.18s ease;
}

.option-card.active {
  border-color: #e3b65c;
  background: #fdf3da;
  box-shadow: inset 0 0 0 1rpx rgba(227, 182, 92, 0.25);
}

.option-title {
  color: #4d432f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.option-card.active .option-title {
  color: #9a6200;
}

.option-sub {
  margin-top: 6rpx;
  color: #9a907f;
  font-size: 21rpx;
  line-height: 1.4;
}

/* ---------- Company meta ---------- */
.company-meta {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.confidence {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.confidence-official {
  background: #e6f4ea;
  color: #2f7a4b;
}

.confidence-measured {
  background: #e8f0fb;
  color: #3b6b9e;
}

.confidence-estimate {
  background: #fbf0d5;
  color: #9a6200;
}

.meta-text {
  color: #a29683;
  font-size: 21rpx;
}

.company-desc {
  margin-top: 10rpx;
  color: #6f6454;
  font-size: 23rpx;
  line-height: 1.55;
}

.company-source {
  margin-top: 8rpx;
  color: #a29683;
  font-size: 21rpx;
  line-height: 1.5;
}

.preset-chips {
  margin-top: 14rpx;
}

.preset-note {
  margin-top: 10rpx;
  color: #9a7a3e;
  font-size: 21rpx;
  line-height: 1.5;
}

/* ---------- Fee / quantity ---------- */
.fee-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 26rpx;
}

.fee-main {
  flex: 1;
  min-width: 0;
}

.fee-input-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 2rpx;
  border-bottom: 1rpx solid #e9dfce;
}

.fee-input {
  flex: 1;
  height: 86rpx;
  padding: 0;
  color: #2f2a22;
  font-size: 62rpx;
  font-weight: 750;
  line-height: 86rpx;
}

.fee-input::placeholder {
  color: #d9d0c1;
}

.fee-unit {
  color: #8c8170;
  font-size: 26rpx;
  font-weight: 600;
}

.fee-basis {
  margin-top: 8rpx;
  color: #9a907f;
  font-size: 21rpx;
  line-height: 1.4;
}

.fee-extra {
  margin-top: 6rpx;
  color: #b08a4a;
  font-size: 21rpx;
  line-height: 1.4;
}

.qty-box {
  width: 246rpx;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
  margin-top: 6rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f6f1e7;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #7c6d55;
  font-size: 32rpx;
  line-height: 1;
}

.stepper-value {
  min-width: 60rpx;
  color: #3b342a;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.fee-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.text-link {
  color: #a56d0b;
  font-size: 22rpx;
  font-weight: 600;
}

.advanced-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.advanced-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 62rpx;
}

.advanced-row + .advanced-row {
  border-top: 1rpx solid #f0e9dc;
}

.advanced-row switch,
.switch-row switch {
  transform: scale(0.75);
  transform-origin: right center;
}

.advanced-label {
  color: #6f6454;
  font-size: 23rpx;
}

.mini-chips {
  display: flex;
  gap: 8rpx;
}

.mini-chip {
  padding: 8rpx 14rpx;
  border: 1rpx solid #e9dfce;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #8c8170;
  font-size: 21rpx;
  line-height: 1.2;
}

.mini-chip.active {
  border-color: #e3b65c;
  background: #fbf0d5;
  color: #9a6200;
  font-weight: 650;
}

.mini-input {
  width: 150rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e9dfce;
  border-radius: 10rpx;
  background: #fffdf8;
  color: #4d432f;
  font-size: 23rpx;
  text-align: right;
}

.advanced-tip {
  margin-top: 12rpx;
  color: #a29683;
  font-size: 20rpx;
  line-height: 1.5;
}

.fee-lines {
  margin-top: 20rpx;
  padding-top: 4rpx;
  border-top: 1rpx dashed #eee5d7;
}

.fee-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
}

.fee-line-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.fee-line-label {
  color: #5f5342;
  font-size: 23rpx;
}

.fee-line-basis {
  color: #a29683;
  font-size: 20rpx;
}

.fee-line-amount {
  flex-shrink: 0;
  color: #c05a3e;
  font-size: 24rpx;
  font-weight: 650;
}

/* ---------- Rate ---------- */
.rate-block {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eee5d7;
}

.rate-big {
  margin-top: 4rpx;
  color: #2f2a22;
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: 1rpx;
}

.rate-unit {
  color: #8c8170;
  font-size: 26rpx;
  font-weight: 500;
}

.rate-sub {
  margin-top: 6rpx;
  color: #a29683;
  font-size: 21rpx;
}

.sync-btn {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f5c85e;
  color: #5a3b00;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(226, 170, 48, 0.2);
}

.manual-rate-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #eee5d7;
  border-radius: 14rpx;
  background: #fffdf8;
}

.manual-label {
  flex-shrink: 0;
  color: #8c8170;
  font-size: 22rpx;
}

.manual-rate-input {
  flex: 1;
  height: 52rpx;
  padding: 0;
  color: #3b342a;
  font-size: 26rpx;
  text-align: right;
}

.manual-unit {
  flex-shrink: 0;
  color: #a29683;
  font-size: 20rpx;
}

.rate-foot {
  margin-top: 14rpx;
  color: #a29683;
  font-size: 21rpx;
  line-height: 1.5;
}

/* ---------- Field rows ---------- */
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0e9dc;
}

.field-row.compact {
  min-height: 72rpx;
  border-bottom: 0;
}

.field-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.field-label {
  color: #5f5342;
  font-size: 24rpx;
}

.field-hint {
  color: #a29683;
  font-size: 20rpx;
  line-height: 1.4;
}

.field-input-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  gap: 6rpx;
  width: 270rpx;
}

.field-input {
  flex: 1;
  height: 60rpx;
  padding: 0;
  color: #3b342a;
  font-size: 28rpx;
  text-align: right;
}

.field-input::placeholder {
  color: #d9d0c1;
}

.field-unit {
  flex-shrink: 0;
  color: #a29683;
  font-size: 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 16rpx 0 4rpx;
}

/* ---------- Reconcile ---------- */
.reconcile-result {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.reconcile-status {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.reconcile-neutral {
  background: #f1eadc;
  color: #8c8170;
}

.reconcile-warn {
  background: #fbe9e2;
  color: #b04a2e;
}

.reconcile-good {
  background: #e6f4ea;
  color: #2f7a4b;
}

.reconcile-tip {
  margin-top: 14rpx;
  color: #a29683;
  font-size: 20rpx;
  line-height: 1.5;
}

/* ---------- Result grid ---------- */
.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  width: calc(50% - 6rpx);
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fbf8f2;
}

.grid-label {
  color: #9a907f;
  font-size: 20rpx;
}

.grid-value {
  color: #3b342a;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.35;
}

/* ---------- Cashback ---------- */
.cashback-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fbf0d5;
  color: #9a6200;
  font-size: 22rpx;
  font-weight: 700;
}

/* ---------- Result card ---------- */
.result-card {
  border-color: #3b342a;
  background: #2f2a22;
  color: #f8f1e4;
  box-shadow: 0 18rpx 40rpx rgba(47, 42, 34, 0.18);
}

.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-label {
  color: #b9ad99;
  font-size: 23rpx;
}

.result-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.result-per {
  margin-top: 8rpx;
  color: #cfc3ae;
  font-size: 23rpx;
}

.result-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(245, 200, 94, 0.16);
  color: #f5c85e;
  font-size: 21rpx;
  font-weight: 650;
}

.result-save-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
}

.saving {
  color: #f0d9a0;
  font-size: 22rpx;
  line-height: 1.4;
}

.actual-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #3e8e5a;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
}

.result-card .result-grid {
  margin-top: 14rpx;
}

.result-card .grid-item {
  background: rgba(255, 255, 255, 0.07);
}

.result-card .grid-label {
  color: #b9ad99;
}

.result-card .grid-value {
  color: #ffffff;
}

.breakdown {
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.breakdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 9rpx 0;
  color: #cfc3ae;
  font-size: 22rpx;
}

.breakdown-row text:last-child {
  color: #f8f1e4;
  font-weight: 600;
}

.warnings,
.notes {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
}

.warnings {
  background: rgba(192, 90, 62, 0.18);
}

.notes {
  background: rgba(255, 255, 255, 0.06);
}

.warning-item {
  color: #ffc9b8;
  font-size: 21rpx;
  line-height: 1.55;
}

.note-item {
  color: #cfc3ae;
  font-size: 21rpx;
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}

.action-btn.primary {
  background: #f5c85e;
  color: #4a3100;
}

.action-btn.secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.06);
  color: #f8f1e4;
}

/* ---------- Empty state ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 28rpx;
  border-style: dashed;
  border-color: #e3d8c5;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: none;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fbf0d5;
  color: #b07a18;
  font-size: 40rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 18rpx;
  color: #5f5342;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  color: #9a907f;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* ---------- Disclaimer ---------- */
.disclaimer {
  margin-top: 8rpx;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.45);
}

.disclaimer-title {
  margin-bottom: 8rpx;
  color: #7c6d55;
  font-size: 23rpx;
  font-weight: 700;
}

.disclaimer-text {
  margin-top: 6rpx;
  color: #9a907f;
  font-size: 20rpx;
  line-height: 1.55;
}

.page-bottom-space {
  height: 150rpx;
}

