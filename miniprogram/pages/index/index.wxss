page {
  height: 100vh;
  background: #f5f5f7;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx;
}

.calculator {
  min-height: calc(100vh - 32rpx);
  box-sizing: border-box;
  padding: 24rpx 24rpx 36rpx;
  border-radius: 30rpx;
  background: #fff;
}

.title {
  margin-bottom: 32rpx;
  color: #111;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.label {
  flex: 1;
  color: #14284b;
  font-size: 30rpx;
  line-height: 1.4;
}

.input {
  width: 344rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #d5d5d5;
  border-radius: 14rpx;
  color: #647083;
  font-size: 30rpx;
  text-align: right;
}

.calculate-button {
  height: 96rpx;
  margin: 48rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  background: #ce0d31;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.calculate-button::after {
  border: 0;
}

.result {
  margin-top: 30rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff5f6;
  color: #14284b;
  font-size: 28rpx;
}

.result-row,
.final-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.final-row {
  margin-top: 8rpx;
  border-top: 1rpx solid #efcdd2;
  color: #ce0d31;
  font-weight: 700;
}

.formula {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 132rpx;
  color: #647083;
  font-size: 24rpx;
  line-height: 1.45;
}

.formula-title {
  color: #14284b;
}
