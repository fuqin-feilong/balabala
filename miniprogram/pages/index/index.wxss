page {
  height: 100vh;
  background: #f5f5f7;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx;
}

.announcement {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff5f6;
  color: #ce0d31;
}

.announcement-label {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.ticker-window {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: ticker 14s linear infinite;
}

.ticker-text {
  flex-shrink: 0;
  margin-right: 96rpx;
  font-size: 25rpx;
}

@keyframes ticker {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.calculator {
  min-height: calc(100vh - 32rpx);
  box-sizing: border-box;
  padding: 24rpx 24rpx 36rpx;
  border-radius: 30rpx;
  background: #fff;
}

.title {
  margin-bottom: 32rpx;
  color: #111;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.label {
  flex: 1;
  color: #14284b;
  font-size: 30rpx;
  line-height: 1.4;
}

.label-with-help {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.label-with-help .label {
  flex: 0 1 auto;
}

.help-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-left: 10rpx;
  border: 1rpx solid #647083;
  border-radius: 50%;
  color: #647083;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.help-wrap {
  position: relative;
  flex-shrink: 0;
}

.help-bubble {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #efcdd2;
  border-radius: 12rpx;
  background: #fff5f6;
  box-shadow: 0 8rpx 24rpx rgba(20, 40, 75, 0.12);
  color: #647083;
  font-size: 23rpx;
  line-height: 1.45;
}

.help-title {
  color: #ce0d31;
  font-weight: 700;
}

.tax-fee-row {
  display: block;
  padding: 14rpx 0;
}

.tax-fee-main {
  display: flex;
  align-items: center;
}

.tax-fee-controls {
  width: 344rpx;
  flex-shrink: 0;
}

.currency-switch {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.currency-option {
  padding: 6rpx 14rpx;
  border: 1rpx solid #d5d5d5;
  border-radius: 8rpx;
  color: #647083;
  font-size: 22rpx;
  line-height: 1.3;
}

.currency-option.active {
  border-color: #ce0d31;
  background: #ce0d31;
  color: #fff;
}

.input {
  width: 344rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #d5d5d5;
  border-radius: 14rpx;
  color: #647083;
  font-size: 30rpx;
  text-align: right;
}

.input-with-unit {
  display: flex;
  align-items: center;
  width: 344rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding-right: 20rpx;
  border: 1rpx solid #d5d5d5;
  border-radius: 14rpx;
}

.input-with-unit .input {
  width: auto;
  flex: 1;
  height: 78rpx;
  padding-right: 8rpx;
  border: 0;
}

.input-unit {
  flex-shrink: 0;
  color: #647083;
  font-size: 26rpx;
}

.calculate-button {
  height: 96rpx;
  margin: 48rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  background: #ce0d31;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.calculate-button::after {
  border: 0;
}

.result {
  margin-top: 30rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff5f6;
  color: #14284b;
  font-size: 28rpx;
}

.result-row,
.final-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.final-row {
  margin-top: 8rpx;
  border-top: 1rpx solid #efcdd2;
  color: #ce0d31;
  font-weight: 700;
}

.formula {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 132rpx;
  color: #647083;
  font-size: 24rpx;
  line-height: 1.45;
}

.formula-title {
  color: #14284b;
}
